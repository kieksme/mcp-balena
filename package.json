{
  "name": "@kieksme/balena-mcp",
  "version": "0.3.0",
  "description": "MCP server for the balenaCloud API",
  "type": "module",
  "bin": {
    "balena-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kieksme/mcp-balena.git"
  },
  "homepage": "https://github.com/kieksme/mcp-balena#readme",
  "license": "GPL-3.0-or-later",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "bundle:mcpb": "node scripts/build-mcpb.mjs",
    "smoke:mcpb": "node scripts/smoke-mcpb.mjs",
    "pack:check": "pnpm pack --pack-destination /tmp"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.33.2"
}

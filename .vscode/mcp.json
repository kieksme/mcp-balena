{
  "inputs": [
    { "id": "balena-api-token", "type": "promptString", "description": "Balena API token", "password": true }
  ],
  "servers": {
    "balena": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@kieksme/balena-mcp"],
      "env": { "BALENA_API_TOKEN": "${input:balena-api-token}" }
    }
  }
}
